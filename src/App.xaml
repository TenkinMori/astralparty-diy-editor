<Application x:Class="DiyEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiyEditor"
             StartupUri="MainWindow.xaml">

  <Application.Resources>

    <!-- ============================== 字体 ==============================
         苹方 特粗（PingFangSC-Semibold.ttf）随 exe 一起打包，pack URI 直接引用。 -->
    <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#PingFang SC</FontFamily>

    <!-- ============================== 颜色 ==============================
         Accent 那一组是"主题色"，设置里换色时在运行时替换，所以用到的地方
         一律 DynamicResource。 -->
    <SolidColorBrush x:Key="Fg" Color="#FFF4F7FC" />
    <SolidColorBrush x:Key="FgDim" Color="#FFB7C4D8" />
    <SolidColorBrush x:Key="FgFaint" Color="#FF8493AB" />
    <SolidColorBrush x:Key="Accent" Color="#FF8FD8FF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#4D8FD8FF" />
    <SolidColorBrush x:Key="AccentGlow" Color="#998FD8FF" />
    <SolidColorBrush x:Key="AccentDeep" Color="#FF08111C" />
    <SolidColorBrush x:Key="AccentWarm" Color="#FFFFB4D2" />
    <SolidColorBrush x:Key="OkBrush" Color="#FF63E6A8" />
    <SolidColorBrush x:Key="BadBrush" Color="#FFFF7A8A" />
    <SolidColorBrush x:Key="WaitBrush" Color="#FFF2C86B" />

    <!-- 玻璃面板的薄色 / 描边（Material You 的 surface 感觉） -->
    <SolidColorBrush x:Key="GlassTint" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="GlassTintSoft" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="GlassEdge" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="GlassEdgeSoft" Color="#24FFFFFF" />

    <!-- ========================== 细滚动条 ========================== -->
    <Style x:Key="SlimThumb" TargetType="Thumb">
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Bar" CornerRadius="3" Background="#33FFFFFF" Margin="3,2" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="#73FFFFFF" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="#A6FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="11" />
      <Setter Property="MinWidth" Value="11" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                Focusable="False" IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SlimThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                Focusable="False" IsTabStop="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================ 玻璃面板 ============================
         GlassSurface 的模板：底下一块被高斯模糊的背景截图，上面盖一层薄色，
         再一颗描边，最后才是内容。 -->
    <Style TargetType="{x:Type local:GlassSurface}">
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type local:GlassSurface}">
            <Grid>
              <Grid x:Name="PART_Host" ClipToBounds="True">
                <Rectangle x:Name="PART_Fill" />
              </Grid>
              <Border x:Name="PART_Tint" Background="{TemplateBinding Tint}"
                      CornerRadius="{TemplateBinding CornerRadius}" />
              <Border x:Name="PART_Edge" BorderBrush="{TemplateBinding EdgeBrush}"
                      BorderThickness="{TemplateBinding EdgeThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}" />
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 胶囊 -->
    <Style x:Key="Cap" TargetType="{x:Type local:GlassSurface}"
           BasedOn="{StaticResource {x:Type local:GlassSurface}}">
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="BlurRadius" Value="28" />
      <Setter Property="Padding" Value="24,20" />
      <Setter Property="Tint" Value="{StaticResource GlassTint}" />
      <Setter Property="EdgeBrush" Value="{StaticResource GlassEdge}" />
      <Setter Property="EdgeThickness" Value="1" />
    </Style>

    <Style x:Key="CapBig" TargetType="{x:Type local:GlassSurface}" BasedOn="{StaticResource Cap}">
      <Setter Property="CornerRadius" Value="30" />
      <Setter Property="BlurRadius" Value="28" />
      <Setter Property="Padding" Value="28,24" />
    </Style>

    <Style x:Key="CapSoft" TargetType="{x:Type local:GlassSurface}" BasedOn="{StaticResource Cap}">
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Tint" Value="{StaticResource GlassTintSoft}" />
      <Setter Property="EdgeBrush" Value="{StaticResource GlassEdgeSoft}" />
      <Setter Property="Padding" Value="20,16" />
    </Style>

    <!-- 药丸：动作按钮（CapPill）和状态小胶囊（CapChip）都用满圆角 -->
    <Style x:Key="CapPill" TargetType="{x:Type local:GlassSurface}" BasedOn="{StaticResource Cap}">
      <Setter Property="CornerRadius" Value="32" />
      <Setter Property="BlurRadius" Value="28" />
      <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="CapChip" TargetType="{x:Type local:GlassSurface}" BasedOn="{StaticResource Cap}">
      <Setter Property="CornerRadius" Value="32" />
      <Setter Property="BlurRadius" Value="28" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="Tint" Value="{StaticResource GlassTintSoft}" />
      <Setter Property="EdgeBrush" Value="{StaticResource GlassEdgeSoft}" />
    </Style>

    <!-- 侧边栏 / 顶栏：贴边、不圆角 -->
    <Style x:Key="SideBar" TargetType="{x:Type local:GlassSurface}" BasedOn="{StaticResource Cap}">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BlurRadius" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Tint" Value="{StaticResource GlassTintSoft}" />
      <Setter Property="EdgeThickness" Value="0" />
    </Style>

    <Style x:Key="TopBar" TargetType="{x:Type local:GlassSurface}" BasedOn="{StaticResource SideBar}">
      <Setter Property="BlurRadius" Value="28" />
      <Setter Property="Tint" Value="{StaticResource GlassTintSoft}" />
    </Style>

    <!-- ============================== 文字 ============================== -->
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="32" />
    </Style>
    <Style x:Key="Metric" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource FgFaint}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- 卡片（GlassSurface）里的表单标签：背景图透过来时 FgFaint(#8493AB) 太糊，
         实测在明亮壁纸区域几乎读不出来，所以这一步用更亮的颜色。 -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFE4EAF5" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="FieldHint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFD3DCEC" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource FgFaint}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ========================== 侧边栏按钮 ========================== -->
    <Style x:Key="NavToggle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource FgDim}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,3,0,3" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Shell" CornerRadius="17" Background="Transparent"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="#1FFFFFFF" />
                <Setter Property="Foreground" Value="{StaticResource Fg}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Fg}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================== 按钮 ============================== -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" CornerRadius="18" Background="#26FFFFFF"
                    BorderBrush="#33FFFFFF" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="#40FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="#1AFFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Shell" Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Foreground" Value="{DynamicResource AccentDeep}" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" CornerRadius="18"
                    Background="{DynamicResource Accent}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shell" Property="Opacity" Value="0.72" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Shell" Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主页的大胶囊（整块毛玻璃 + 悬停提亮） -->
    <Style x:Key="CapsuleTile" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <local:GlassSurface x:Name="Glass" Style="{StaticResource CapPill}">
              <!-- ★★★ 2026-10-03（用户："**右侧的大小 日期还有那个什么的都移动到按钮的
                   右侧，居右对齐**"）——这里原来**写死**了 `HorizontalAlignment="Left"`：
                   它把上面那个 `HorizontalContentAlignment = Stretch` **压掉了**，
                   于是胶囊内容（那一行 Grid）只拿到**自己的期望宽度**，
                   Grid 里的"星号空档列"永远分到 0 ⇒ 右块只能停在内容宽度处
                   （实测：`grid=356.06 col2=0`，而胶囊本身有 987 px 宽）
                   ⇒ 用户看到的正是"数字飘在中间"。
                   ⇒ 改成 `{TemplateBinding HorizontalContentAlignment}`（= Stretch）后，
                     内容撑满、星号列分到空档 ⇒ 右块**紧贴「删除」按钮左侧、整体右对齐**。
                   ★ 自测盯着这一条：`WindowSmoke.CapsuleRowGeom`（右块→右边界 = 固定小间距）。 -->
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </local:GlassSurface>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glass" Property="Tint" Value="#45FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Glass" Property="Tint" Value="#26000000" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Glass" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ======================= 自绘窗口按钮 ======================= -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Foreground" Value="{StaticResource FgDim}" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeClose" TargetType="Button" BasedOn="{StaticResource Chrome}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFFF7A8A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================ 输入框 ============================ -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Shell" CornerRadius="17" Background="#3D000000"
                    BorderBrush="#33FFFFFF" BorderThickness="1"
                    MinHeight="{TemplateBinding MinHeight}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentGlow}" />
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="#26000000" />
                <Setter Property="Foreground" Value="{StaticResource FgDim}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Shell" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ========================== 下拉框（深色，别白底白字） ==========================
         ★ 默认的 ComboBox 模板用的是系统配色：深色窗体里下拉项会是"白底白字"，
           所以这里连**下拉列表本身**一起定死（Popup 里的 Border + ComboBoxItem）。 -->
    <Style x:Key="Drop" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- ★ 铁律：代码里往下拉框塞项，一律塞"实现 ToString() 的值对象 / 纯字符串"，
           **不要塞 ComboBoxItem** —— 这个模板把选中项本身喂给 ContentPresenter，
           塞 ComboBoxItem 就是黑字（_截图\页3 拍到过）。 -->
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="16" Background="#3D000000" BorderBrush="#33FFFFFF"
                            BorderThickness="1" MinHeight="{TemplateBinding MinHeight}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                        <TextBlock Grid.Column="1" Text="&#xE70D;" Margin="8,0,12,0"
                                   FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource FgFaint}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                     Placement="Bottom" PopupAnimation="Fade"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Background="#F2101620" BorderBrush="#3DFFFFFF" BorderThickness="1"
                        CornerRadius="12" Padding="6" Margin="0,4,0,0"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                  <ScrollViewer>
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DropItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Row" CornerRadius="8" Padding="{TemplateBinding Padding}"
                    Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#26FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Swatch" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Ring" CornerRadius="15" BorderBrush="#22FFFFFF" BorderThickness="2"
                    Padding="3">
              <Border x:Name="Chip" CornerRadius="10" Background="{TemplateBinding Background}"
                      RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="#B3FFFFFF" />
                <Setter TargetName="Chip" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================ 滑杆 ============================ -->
    <Style x:Key="Slide" TargetType="Slider">
      <Setter Property="Height" Value="26" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center" Background="Transparent">
              <Border Height="6" CornerRadius="3" Background="#33FFFFFF" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="18" Height="18" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid>
                          <Ellipse Fill="#66000000" Margin="0,1,0,0" />
                          <Ellipse Fill="{DynamicResource Accent}" />
                        </Grid>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource FgDim}" />
      <Setter Property="FontSize" Value="12" />
