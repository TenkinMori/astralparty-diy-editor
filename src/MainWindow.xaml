<Window x:Class="DiyEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiyEditor"
        Title="小小兔趴 · DIY 关卡编辑器"
        Width="1320" Height="850" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" WindowState="Normal"
        Background="#FF0A0D16"
        Foreground="{StaticResource Fg}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDropFile">

  <!-- ★ 外观与启动器一致：同一套 App.xaml 样式副本 + 同一套 GlassSurface 玻璃拟态 +
       同一套自绘标题栏（CaptionHeight=0，只留 6px 缩放边）。
       ★ 只**拷副本**过来用，启动器里的原件一个字都没动。 -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                  GlassFrameThickness="0" CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ==================== 背景层（所有毛玻璃都从这儿取样） ====================
         ★ 这是照 `1-首次安装包\启动器`（只读参考，原件没动）那套搬过来的四层，
           顺序就是"从下往上"：
           ① BackdropArt —— 没自定义背景图时，按主题色重画的 Material You 味渐变
                            （光晕 + 底色，**代码里画**，见 MainWindow.BuildBackdropArt）；
           ② BgImage     —— 外观设置里挑的背景图（预设真图或本地图）；★ 图本身
                            **不挂 BlurEffect**，磨砂只作用在每一块 GlassSurface 上；
           ③ DimLayer    —— 「压暗」那一档，盖在图上，不糊；
           ④ 最上面那层暗压渐变 —— 保证顶栏/侧栏上的字在任何壁纸上都读得出来。 -->
    <Grid x:Name="Backdrop" Grid.RowSpan="2" ClipToBounds="True">
      <Grid x:Name="BackdropArt">
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF0B1420" Offset="0" />
              <GradientStop Color="#FF121A2B" Offset="0.45" />
              <GradientStop Color="#FF0A0F19" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Ellipse Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-320,-420,0,0" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#332E7FB8" Offset="0" />
              <GradientStop Color="#002E7FB8" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-260,-340" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#268E5FA8" Offset="0" />
              <GradientStop Color="#008E5FA8" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
      </Grid>
      <Image x:Name="BgImage" Stretch="UniformToFill" Visibility="Collapsed"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <Rectangle x:Name="DimLayer" Fill="#FF070910" Opacity="0" />
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B3070A11" Offset="0" />
            <GradientStop Color="#33070A11" Offset="0.5" />
            <GradientStop Color="#B3070A11" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <!-- ============================== 顶栏 ============================== -->
    <local:GlassSurface Grid.Row="0" Style="{StaticResource TopBar}"
                        MouseLeftButtonDown="OnTitleBarDown">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="小小兔趴" FontSize="13" Foreground="{StaticResource Fg}" />
          <TextBlock Text="·" FontSize="13" Foreground="{StaticResource FgFaint}" Margin="8,0,8,0" />
          <TextBlock Text="DIY 关卡编辑器" FontSize="12" Foreground="{StaticResource FgFaint}"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="TitleFile" Text="" FontSize="12" Margin="16,0,0,0"
                     Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <!-- ★ 外观：背景图 / 玻璃磨砂 / 压暗 / 主题色（照启动器那套「设置 → 外观」） -->
          <Button x:Name="BtnLook" Style="{StaticResource Chrome}"
                  Content="&#xE790;" ToolTip="外观：背景图 · 玻璃磨砂 · 压暗 · 主题色"
                  Click="OnOpenLook" />
          <Button x:Name="BtnMin" Style="{StaticResource Chrome}"
                  Content="&#xE921;" ToolTip="最小化" Click="OnMinimize" />
          <Button x:Name="BtnMax" Style="{StaticResource Chrome}"
                  Content="&#xE922;" ToolTip="最大化 / 还原" Click="OnMaximize" />
          <Button x:Name="BtnClose" Style="{StaticResource ChromeClose}"
                  Content="&#xE8BB;" ToolTip="关闭" Click="OnClose" />
        </StackPanel>
      </Grid>
    </local:GlassSurface>

    <!-- ============================== 内容 ============================== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <!-- ★ 固定宽度的左导航（用户要求：别挤；右边留白充足） -->
        <ColumnDefinition Width="236" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <local:GlassSurface Grid.Column="0" Style="{StaticResource SideBar}">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="18,18,18,0">
            <TextBlock Text="DIY 关卡编辑器" FontSize="17" Foreground="{StaticResource Fg}" />
            <TextBlock Text="只读写你给的文件 · 不碰服务端" FontSize="11"
                       Foreground="{StaticResource FgFaint}" Margin="0,4,0,0" />
            <Rectangle Height="1" Fill="#1FFFFFFF" Margin="0,16,0,8" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
            <Rectangle Height="1" Fill="#1FFFFFFF" Margin="0,0,0,12" />
            <TextBlock x:Name="NavDocState" Text="还没打开关卡" FontSize="11.5"
                       Foreground="{StaticResource FgFaint}" TextWrapping="Wrap" />
            <TextBlock x:Name="NavDirty" Text="" FontSize="11.5" Margin="0,6,0,0"
                       Foreground="{StaticResource WaitBrush}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Margin="18,0,18,0">
            <RadioButton x:Name="Nav1" Style="{StaticResource NavToggle}" IsChecked="True"
                         Tag="templates" Checked="OnNavChanged">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                           FontSize="15" VerticalAlignment="Center" />
                <TextBlock Text="地图模板 / 新建" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="Nav2" Style="{StaticResource NavToggle}"
                         Tag="board" Checked="OnNavChanged">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF0E2;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                           FontSize="15" VerticalAlignment="Center" />
                <TextBlock Text="棋盘" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="Nav3" Style="{StaticResource NavToggle}"
                         Tag="story" Checked="OnNavChanged">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                           FontSize="15" VerticalAlignment="Center" />
                <TextBlock Text="进度 / 事件" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="Nav4" Style="{StaticResource NavToggle}"
                         Tag="monsters" Checked="OnNavChanged">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                           FontSize="15" VerticalAlignment="Center" />
                <TextBlock Text="怪物" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="Nav5" Style="{StaticResource NavToggle}"
                         Tag="lint" Checked="OnNavChanged">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                           FontSize="15" VerticalAlignment="Center" />
                <TextBlock Text="校验 / 保存" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="Nav6" Style="{StaticResource NavToggle}"
                         Tag="export" Checked="OnNavChanged">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                           FontSize="15" VerticalAlignment="Center" />
                <TextBlock Text="导出 / 说明" Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </DockPanel>
      </local:GlassSurface>

      <!-- 右侧：一页一块，点导航换 Visible（★ 这就是"分页"，不是一页堆一坨） -->
      <Grid Grid.Column="1" Margin="18,18,18,18">
        <local:PageTemplates x:Name="PageTemplates" />
        <local:PageBoard x:Name="PageBoard" Visibility="Collapsed" />
        <local:PageStory x:Name="PageStory" Visibility="Collapsed" />
        <local:PageMonsters x:Name="PageMonsters" Visibility="Collapsed" />
        <local:PageLint x:Name="PageLint" Visibility="Collapsed" />
        <local:PageExport x:Name="PageExport" Visibility="Collapsed" />
      </Grid>
    </Grid>
  </Grid>
</Window>
