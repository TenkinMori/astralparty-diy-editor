<UserControl x:Class="DiyEditor.PageBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiyEditor"
             Focusable="True" PreviewKeyDown="OnKeyDown">
  <!-- 第②页：棋盘。平面棋盘 + 平移缩放 + 左键右侧换格 + 右键（新增怪物 / 还原原版）+ 存读本地。 -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ── 标题 ─────────────────────────────────────────────────────── -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="棋盘" Style="{StaticResource H2}" />
      <TextBlock x:Name="SubLine" Style="{StaticResource Note}" Margin="0,8,0,0" MaxWidth="1100"
                 HorizontalAlignment="Left" Text="还没打开关卡。先去「地图模板 / 新建」建一份。" />
      <TextBlock x:Name="TexLine" Style="{StaticResource FieldHint}" Margin="0,6,0,0" MaxWidth="1100"
                 HorizontalAlignment="Left" Text="" />
    </StackPanel>

    <!-- ── 工具条 ───────────────────────────────────────────────────── -->
    <StackPanel Grid.Row="1" Margin="0,12,0,10">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnFit" Style="{StaticResource Ghost}" Content="适应窗口" Click="OnFit" />
        <Button x:Name="BtnReset" Style="{StaticResource Ghost}" Content="1:1"
                Margin="10,0,0,0" Click="OnReset" />
        <Button x:Name="BtnUndo" Style="{StaticResource Ghost}" Content="撤销 (Ctrl+Z)"
                Margin="10,0,0,0" Click="OnUndo"
                ToolTip="编辑动作和视图共用一个撤销栈（换格 / 视图缩放平移）。" />
        <Button x:Name="BtnRedo" Style="{StaticResource Ghost}" Content="重做 (Ctrl+Y)"
                Margin="10,0,0,0" Click="OnRedo" />

        <CheckBox x:Name="ChkMonsters" Style="{StaticResource Check}" Content="显示怪物"
                  IsChecked="True" VerticalAlignment="Center" Margin="18,0,0,0"
                  ToolTip="把怪物池里放到棋盘上的怪画出来（头像），默认开。"
                  Checked="OnToggleDraw" Unchecked="OnToggleDraw" />
        <CheckBox x:Name="ChkIds" Style="{StaticResource Check}" Content="显示编号"
                  VerticalAlignment="Center" Margin="14,0,0,0"
                  ToolTip="在每格右上角显示格子编号（默认关：只看贴图最干净）"
                  Checked="OnToggleDraw" Unchecked="OnToggleDraw" />
        <CheckBox x:Name="ChkLinks" Style="{StaticResource Check}" Content="显示连线"
                  IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0"
                  ToolTip="相邻格子之间的连线（默认开）。"
                  Checked="OnToggleDraw" Unchecked="OnToggleDraw" />
        <TextBlock Text="格子大小" Style="{StaticResource FieldLabel}"
                   VerticalAlignment="Center" Margin="18,0,0,0" />
        <ComboBox x:Name="NodeSizePick" Style="{StaticResource Drop}" Width="186"
                  VerticalAlignment="Center" Margin="8,0,0,0"
                  SelectionChanged="OnNodeSizeChanged"
                  ToolTip="棋盘上每一格画多大（= 格距的百分之多少）。默认「中 60%」。">
          <ComboBoxItem Content="小 · 格距的 45%" Tag="0.45" />
          <ComboBoxItem Content="中 · 格距的 60%（默认）" Tag="0.60" IsSelected="True" />
          <ComboBoxItem Content="大 · 格距的 72%" Tag="0.72" />
          <ComboBoxItem Content="特大 · 格距的 85%" Tag="0.85" />
        </ComboBox>
        <Button x:Name="BtnSide" Style="{StaticResource Ghost}" Content="收起侧栏"
                Margin="18,0,0,0" Click="OnToggleSide"
                ToolTip="把右边的「格子 / 图例 / 落点」折起来，整块宽度让给棋盘" />
      </StackPanel>

      <!-- ★★ 刷怪归属（2026-10-08 大改）：棋盘上每一只怪都归属某个"组" ——
           组 = 某个事件（落盘键 = `DiyPool.EventKeyOf`）或"开局就在场上"（`Event = 0`，写进 start_monsters）。
           切到哪一组，棋盘就**只画**那一组放的怪，右键放的怪也进这一组。
           ★ 这是**视图状态**：切换不落盘、不改任何 json；但要在"整页重建"之后还在 ⇒
             存在 PageBoard 的字段 `_groupEvent` 里，Reload 时按它把下拉选回来。 -->
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <TextBlock Text="刷怪归属" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
        <ComboBox x:Name="GroupPick" Style="{StaticResource Drop}" Width="336"
                  VerticalAlignment="Center" Margin="8,0,0,0"
                  SelectionChanged="OnGroupChanged"
                  ToolTip="棋盘上显示 / 放置哪一组的怪：开局就在场上（写进 start_monsters）或某个事件（写进那个事件的 spawn）。切换只是看哪一组，不改任何数据；别的组的怪这一眼不画。" />
        <TextBlock x:Name="GroupNote" Style="{StaticResource FieldHint}" VerticalAlignment="Center"
                   Margin="12,0,0,0" Text="" />
      </StackPanel>

      <TextBlock x:Name="ZoomLine" Style="{StaticResource FieldHint}" Margin="2,10,0,0" Text="" />

      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <TextBlock Text="DIY 关卡名" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Style="{StaticResource Field}" Width="240" Margin="10,0,0,0"
                 MaxLength="60" />
        <Button x:Name="BtnSave" Style="{StaticResource Primary}" Content="保存到本地 DIY 关卡"
                Margin="12,0,0,0" Click="OnSave" />
        <Button x:Name="BtnOpenDiy" Style="{StaticResource Ghost}" Content="重新读取"
                Margin="10,0,0,0" Click="OnReload" />
        <TextBlock x:Name="SaveLine" Style="{StaticResource FieldHint}" VerticalAlignment="Center"
                   Margin="16,0,0,0" TextWrapping="NoWrap" Text="" />
      </StackPanel>
    </StackPanel>

    <!-- ── 棋盘 + 侧栏 ──────────────────────────────────────────────── -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition x:Name="SideCol" Width="376" />
      </Grid.ColumnDefinitions>

      <local:GlassSurface Grid.Column="0" Style="{StaticResource Cap}" Padding="0">
        <Grid x:Name="CanvasHost" Background="#FF0C1119" ClipToBounds="True"
              MouseWheel="OnWheel" MouseLeftButtonDown="OnMouseDown"
              MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp"
              MouseRightButtonDown="OnRightDown"
              SizeChanged="OnHostResize">
          <Canvas x:Name="BoardCanvas" Background="Transparent" />
          <!-- 左上角操作提示 -->
          <Border x:Name="HintBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                  Background="#B2080C14" CornerRadius="10" Padding="12,9,14,9"
                  BorderBrush="#33FFFFFF" BorderThickness="1">
            <TextBlock x:Name="HintText" FontSize="11.5"
                       Foreground="{StaticResource FgFaint}" TextWrapping="Wrap" MaxWidth="340"
                       Text="左键点一格：右侧列出各种功能格子，点一下就换。&#x0a;右键某一格：新增怪物（进当前「刷怪归属」那一组）/ 编辑这一格的怪… / 拿下这一格的怪 / 还原原版。&#x0a;顶部「刷怪归属」切到哪个事件，棋盘就只看 / 只放那个进度刷的怪。&#x0a;W A S D 平移 · 滚轮缩放 · 左键拖拽平移 · Ctrl+Z / Ctrl+Y 撤销。" />
          </Border>

          <!-- ★★ 只给离屏截图用（开关名见 App 里的 ctx-menu）：把右键菜单那两项平铺出来。
               为什么要这一块：真人右键弹出的菜单是 WPF 的 ContextMenu（活在另一个 Popup 里），
               RenderTargetBitmap 渲不到它 ⇒ 截图里永远拍不到"右键菜单展开"的样子。
               这块摆的是同一份两项（BuildCellMenu 造的就是这两项），只是不用 Popup。
               真人用时它是折叠的，一个像素都不占。 -->
          <Border x:Name="CtxMenuPreviewBox" Visibility="Collapsed"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="380,84,0,0"
                  Background="#F2080C14" CornerRadius="10" Padding="12,10,16,12"
                  BorderBrush="#44FFFFFF" BorderThickness="1">
            <StackPanel>
              <TextBlock x:Name="CtxMenuPreviewHead" Style="{StaticResource FieldHint}"
                         Margin="0,0,0,7" MaxWidth="430" TextWrapping="Wrap" Text="" />
              <Border Background="#33FFFFFF" CornerRadius="8" Padding="4">
                <StackPanel x:Name="CtxMenuPreview" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </local:GlassSurface>

      <ScrollViewer x:Name="SideScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="16,0,0,0">
        <StackPanel>
          <local:GlassSurface Style="{StaticResource Cap}">
            <StackPanel>
              <TextBlock Text="格子" Style="{StaticResource H1}" />
              <TextBlock x:Name="NodeNote" Style="{StaticResource FieldHint}" Margin="0,10,0,0"
                         TextWrapping="Wrap"
                         Text="左键点棋盘上任意一格：这一格的信息和下面那排「功能格子」就出来了。" />

              <StackPanel x:Name="NodeEditor" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="换成什么功能（点图标就换）" Style="{StaticResource FieldLabel}"
                           Margin="0,0,0,6" />
                <WrapPanel x:Name="LandTiles" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Button x:Name="BtnRevert" Style="{StaticResource Ghost}" Content="还原原版"
                          HorizontalAlignment="Left" Click="OnRevertCell"
                          ToolTip="把这一格还原成官方原本的功能（删掉 diy.landType）。" />
                  <TextBlock x:Name="LandGroupNote" Style="{StaticResource FieldHint}"
                             VerticalAlignment="Center" Margin="12,0,0,0" Text="" />
                </StackPanel>
              </StackPanel>

              <TextBlock x:Name="ChangedNote" Style="{StaticResource FieldHint}" Margin="0,12,0,0"
                         TextWrapping="Wrap" Text="" />
            </StackPanel>
          </local:GlassSurface>

          <local:GlassSurface Style="{StaticResource Cap}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="这一块棋盘" Style="{StaticResource H1}" />
              <TextBlock x:Name="BoardNote" Style="{StaticResource FieldHint}" Margin="0,10,0,0"
                         TextWrapping="Wrap" Text="" />
              <TextBlock Text="玩家起点" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
              <TextBlock x:Name="StartsNote" Style="{StaticResource FieldHint}" TextWrapping="Wrap" />
            </StackPanel>
          </local:GlassSurface>

          <local:GlassSurface Style="{StaticResource Cap}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="格子图例" Style="{StaticResource H1}" />
              <TextBlock x:Name="LegendNote" Style="{StaticResource FieldHint}" Margin="0,10,0,0"
                         TextWrapping="Wrap" Text="" />
              <WrapPanel x:Name="Legend" Margin="0,10,0,0" />
            </StackPanel>
          </local:GlassSurface>

          <local:GlassSurface Style="{StaticResource Cap}" Margin="0,14,0,20">
            <StackPanel>
              <TextBlock Text="怪物落点" Style="{StaticResource H1}" />
              <TextBlock x:Name="SpawnNote" Style="{StaticResource FieldHint}" Margin="0,10,0,0"
                         TextWrapping="Wrap" Text="" />
              <StackPanel x:Name="SpawnList" Margin="0,10,0,0" />
            </StackPanel>
          </local:GlassSurface>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
