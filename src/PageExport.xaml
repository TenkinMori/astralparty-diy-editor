<UserControl x:Class="DiyEditor.PageExport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DiyEditor">
  <!-- 第⑥页：导出 / 说明。不写任何文件，只说明这份 JSON 谁读、怎么读。 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                PanningMode="VerticalOnly" Focusable="False">
    <StackPanel Margin="0,0,14,20">
      <TextBlock Text="导出 / 说明" Style="{StaticResource H2}" />
      <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" MaxWidth="1040"
                 HorizontalAlignment="Left"
                 Text="这一页不存文件，只说明这份 JSON 谁读、怎么读。" />

      <!-- ★ 外观（背景图 + 玻璃磨砂）—— 跟启动器那套「设置 → 外观」同一个口径 -->
      <local:GlassSurface Style="{StaticResource CapBig}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="⓪ 外观 · 背景图 / 玻璃磨砂" Style="{StaticResource H1}" />
          <TextBlock Style="{StaticResource FieldHint}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="960"
                     HorizontalAlignment="Left"
                     ToolTip="照 1-首次安装包\启动器（只读参考）那套搬过来的：背景图 + 玻璃磨砂半径 + 背景压暗 + 主题色。磨砂只糊每一块玻璃面板，背景图本身保持清晰。"
                     Text="背景图 · 玻璃磨砂 · 背景压暗 · 主题色 —— 改一项立刻生效。" />
          <TextBlock x:Name="LookNow" Style="{StaticResource Note}" Margin="0,8,0,0" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnLook" Content="打开外观设置…" Style="{StaticResource Primary}"
                    Click="OnOpenLook" />
          </StackPanel>
        </StackPanel>
      </local:GlassSurface>

      <!-- 一份文件，两处入口 -->
      <local:GlassSurface Style="{StaticResource CapBig}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="① 一处定义，两边共用" Style="{StaticResource H1}" />
          <TextBlock Style="{StaticResource FieldHint}" Margin="0,12,0,0" FontFamily="Consolas"
                     Text="编辑器（本程序）──写──▶ &lt;游戏根&gt;\DIY关卡\&lt;名字&gt;.json ◀──读── 服务端 / 客户端" />
          <TextBlock Style="{StaticResource FieldHint}" Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="900"
                     HorizontalAlignment="Left"
                     ToolTip="编辑器不需要联网、不需要服务端在跑；它就是「编辑 + 存盘」。服务端和客户端都只是去读这些文件。"
                     Text="编辑器不联网、不依赖服务端在跑。" />
        </StackPanel>
      </local:GlassSurface>

      <!-- 服务端怎么读 -->
      <local:GlassSurface Style="{StaticResource CapBig}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="② 服务端将来怎么读（推荐第 1 条）" Style="{StaticResource H1}" />

          <Border CornerRadius="14" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                  Padding="14" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="路子 1 推荐：把 DIY 目录当成「多一档难度」读" FontSize="13"
                         Foreground="{StaticResource OkBrush}" />
              <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                         Text="levels.candidate_paths() 后面多试一条 &lt;game_dir&gt;\DIY关卡\&lt;名字&gt;.json。" />
            </StackPanel>
          </Border>

          <Border CornerRadius="14" Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                  Padding="14" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="路子 2：把 DIY 文件拷进 server\data\levels\" FontSize="13"
                         Foreground="{StaticResource WaitBrush}" />
              <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                         ToolTip="最省事，但「保存」就变成「导入」，而且要动线上目录 —— 跟「保存到本地」不符。"
                         Text="要动线上目录，「保存」会变成「导入」。" />
            </StackPanel>
          </Border>

          <Border CornerRadius="14" Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                  Padding="14" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="路子 3：服务端加一个「DIY 配置目录」配置项" FontSize="13"
                         Foreground="{StaticResource FgDim}" />
              <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap"
                         Text="config.py 加一行，默认指向 DIY 目录。" />
            </StackPanel>
          </Border>
        </StackPanel>
      </local:GlassSurface>

      <!-- 格式：官方超集 -->
      <local:GlassSurface Style="{StaticResource CapBig}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="③ 文件格式 = 官方 levels json 的超集 + 一个 diy 块" Style="{StaticResource H1}" />
          <TextBlock Style="{StaticResource FieldHint}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="960"
                     HorizontalAlignment="Left"
                     Text="官方白名单服务端会读；顶层 diy 块服务端不读，只给编辑器用。difficulty 用 1001 起。" />

          <Border CornerRadius="14" Background="#26000000" BorderBrush="#26FFFFFF" BorderThickness="1"
                  Padding="14" Margin="0,14,0,0">
            <TextBlock FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource FgDim}"
                       xml:space="preserve">{
  "map": 82016,  "difficulty": 1001,
  "victory": { "kind": "kill_boss", "targets": [ 1067 ] },

  "diy": {                        // 服务端整块丢掉，只给编辑器/客户端用
    "version": 1,
    "name": "我的图书馆",
    "base_map": 82016,
    "base_scene": "023",          // 画板号：贴图 / 棋盘都靠它找
    "base_level": "82016_1.json", // 底版是哪份官方配置
    "board": "我的图书馆.board.json",
    "events": { "32122": { "effects": [ { "type": "gold", "n": 100 } ] } }
  }
}</TextBlock>
          </Border>

          <TextBlock Style="{StaticResource FieldHint}" Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="960"
                     HorizontalAlignment="Left"
                     ToolTip="棋盘文件照官方 boards 的形状，只加一个 diy 块；改过的格子写 nodes[i].diy.landType，不动 landType 那个官方原始值 —— 所以「还原成官方」永远做得到。"
                     Text="这是新建后的骨架：官方的内容（事件 / 开局怪 / 进度）要自己填。" />
        </StackPanel>
      </local:GlassSurface>

      <!-- 客户端怎么列 -->
      <local:GlassSurface Style="{StaticResource CapBig}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="④ 客户端将来的入口" Style="{StaticResource H1}" />
          <TextBlock Style="{StaticResource FieldHint}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="960"
                     HorizontalAlignment="Left"
                     Text="创建房间页 → 难度那一栏新增一档「DIY 关卡」→ 列出 &lt;游戏根&gt;\DIY关卡\*.json 的文件名。" />
          <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="960"
                     HorizontalAlignment="Left"
                     Text="选中后把 map / difficulty / 名字 塞进建房包，服务端按名字加载。" />
        </StackPanel>
      </local:GlassSurface>

      <!-- 服务端白名单要扩的那一处 -->
      <local:GlassSurface Style="{StaticResource CapSoft}" Margin="0,16,0,16">
        <StackPanel>
          <TextBlock Text="要扩白名单的地方：发星币 / 发牌" Style="{StaticResource FieldLabel}" />
          <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="960"
                     HorizontalAlignment="Left"
                     ToolTip="现有 progress_events 的效果只认 spawn / attack / defense / move。所以「所有玩家获得星币 / 获得某张牌」放进 diy.events 的 effects[]，服务端暂不读。补丁草案只写成文档，不动服务端一个字节。"
                     Text="现在只落 diy.events，服务端暂不读。" />
        </StackPanel>
      </local:GlassSurface>

    </StackPanel>
  </ScrollViewer>
</UserControl>
